<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/dracula_current_line"
    android:padding="8dp"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvSnippetGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Docker"
            android:textSize="9sp"
            android:textColor="@color/dracula_comment"
            android:background="@color/dracula_bg_darker"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvSnippetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Оновити контейнери"
            android:textColor="@color/dracula_fg"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Run action -->
        <ImageButton
            android:id="@+id/btnSnippetRun"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@android:drawable/ic_media_play"
            android:tint="@color/dracula_green"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- Insert action -->
        <ImageButton
            android:id="@+id/btnSnippetInsert"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@android:drawable/ic_menu_send"
            android:tint="@color/dracula_cyan"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="4dp" />

        <!-- Delete action -->
        <ImageButton
            android:id="@+id/btnSnippetDelete"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="@color/dracula_red"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSnippetCommand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@color/dracula_bg_darker"
        android:padding="6dp"
        android:text="docker compose pull &amp;&amp; docker compose up -d"
        android:textColor="@color/dracula_green"
        android:textSize="11sp"
        android:typeface="monospace" />
</LinearLayout>
