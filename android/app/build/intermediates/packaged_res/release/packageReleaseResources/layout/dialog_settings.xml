<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/dracula_bg_darker"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Налаштування UmolkTerm"
            android:textColor="@color/dracula_cyan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- 1. Font Size Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Розмір шрифту терміналу (за замовчуванням 12):"
            android:textColor="@color/dracula_fg"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/sbFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="8"
            android:max="24"
            android:progress="12"
            android:layout_marginBottom="16dp" />

        <!-- 2. Google Authenticator (2FA) Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ Безпека: Google Authenticator (2FA)"
            android:textColor="@color/dracula_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv2FaStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Статус: Перевірка..."
            android:textColor="@color/dracula_comment"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSetup2Fa"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="Налаштувати 2FA (QR-код)"
            android:textColor="@color/dracula_fg"
            android:background="@color/dracula_current_line"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- 3. Export / Import Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦 Переїзд (Експорт та Імпорт)"
            android:textColor="@color/dracula_purple"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnExportBackup"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="📤 Експорт даних"
                android:textColor="@color/dracula_fg"
                android:background="@color/dracula_current_line"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnImportBackup"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="📥 Імпорт даних"
                android:textColor="@color/dracula_fg"
                android:background="@color/dracula_current_line"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
