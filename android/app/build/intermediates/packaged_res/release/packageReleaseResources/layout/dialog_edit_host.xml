<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/dracula_bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SSH Connection"
            android:textColor="@color/dracula_purple"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Host Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Label / Display Name"
            android:textColor="@color/dracula_comment"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editHostLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/dracula_current_line"
            android:textColor="@color/dracula_fg"
            android:hint="e.g. Production Server"
            android:textColorHint="@color/dracula_comment"
            android:padding="10dp"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Hostname / IP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hostname or IP Address *"
            android:textColor="@color/dracula_comment"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editHostAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/dracula_current_line"
            android:textColor="@color/dracula_fg"
            android:hint="e.g. 192.168.1.100 or vps.example.com"
            android:textColorHint="@color/dracula_comment"
            android:padding="10dp"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Port and Username row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Port *"
                    android:textColor="@color/dracula_comment"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/editHostPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/dracula_current_line"
                    android:textColor="@color/dracula_fg"
                    android:text="22"
                    android:inputType="number"
                    android:padding="10dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Username *"
                    android:textColor="@color/dracula_comment"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/editHostUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/dracula_current_line"
                    android:textColor="@color/dracula_fg"
                    android:hint="root / admin"
                    android:textColorHint="@color/dracula_comment"
                    android:padding="10dp"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Auth Method Selector (Password vs Private Key) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Authentication Method"
            android:textColor="@color/dracula_comment"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/radioGroupAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/radioAuthPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="@color/dracula_fg"
                android:checked="true"
                android:buttonTint="@color/dracula_purple"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/radioAuthKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SSH Key"
                android:textColor="@color/dracula_fg"
                android:buttonTint="@color/dracula_purple" />
        </RadioGroup>

        <!-- Password input container -->
        <LinearLayout
            android:id="@+id/containerPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="@color/dracula_comment"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/editHostPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/dracula_current_line"
                android:textColor="@color/dracula_fg"
                android:inputType="textPassword"
                android:hint="••••••••"
                android:textColorHint="@color/dracula_comment"
                android:padding="10dp"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Key picker container -->
        <LinearLayout
            android:id="@+id/containerKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Key from Keyring"
                android:textColor="@color/dracula_comment"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerKeyring"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@color/dracula_current_line" />
        </LinearLayout>

        <!-- Group Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Folder / Group (Optional)"
            android:textColor="@color/dracula_comment"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editHostGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/dracula_current_line"
            android:textColor="@color/dracula_fg"
            android:hint="Default / Servers / Cloud"
            android:textColorHint="@color/dracula_comment"
            android:padding="10dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Action buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnTestConnection"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="⚡ Test"
                android:backgroundTint="@color/dracula_yellow"
                android:textColor="@color/dracula_bg"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnCancelHost"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Cancel"
                android:backgroundTint="@color/dracula_current_line"
                android:textColor="@color/dracula_fg"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSaveHost"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Save"
                android:backgroundTint="@color/dracula_purple"
                android:textColor="@color/dracula_bg"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
