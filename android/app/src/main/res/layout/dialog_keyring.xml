<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/dracula_bg"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SSH Keyring Manager"
        android:textColor="@color/dracula_purple"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnAddNewKey"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="+ Add / Import Private Key"
        android:backgroundTint="@color/dracula_purple"
        android:textColor="@color/dracula_bg"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerKeyring"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:scrollbars="vertical"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnCloseKeyring"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="Close"
        android:backgroundTint="@color/dracula_current_line"
        android:textColor="@color/dracula_fg"
        android:textSize="13sp" />

</LinearLayout>
