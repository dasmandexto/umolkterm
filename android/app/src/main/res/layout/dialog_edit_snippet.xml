<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/dracula_bg"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialogSnippetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Snippet"
        android:textColor="@color/dracula_purple"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Snippet Title *"
        android:textColor="@color/dracula_comment"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/editSnippetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dracula_current_line"
        android:textColor="@color/dracula_fg"
        android:hint="e.g. Docker Status or Nginx Restart"
        android:textColorHint="@color/dracula_comment"
        android:padding="10dp"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Group / Category"
        android:textColor="@color/dracula_comment"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/editSnippetGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dracula_current_line"
        android:textColor="@color/dracula_fg"
        android:hint="e.g. Docker / System / Logs"
        android:textColorHint="@color/dracula_comment"
        android:padding="10dp"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Command / Script *"
        android:textColor="@color/dracula_comment"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/editSnippetCommand"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="top|start"
        android:fontFamily="monospace"
        android:background="@color/dracula_bg_darker"
        android:textColor="@color/dracula_fg"
        android:hint="docker ps --format 'table {{.Names}}\t{{.Status}}'"
        android:textColorHint="@color/dracula_comment"
        android:padding="10dp"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelSnippet"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Cancel"
            android:backgroundTint="@color/dracula_current_line"
            android:textColor="@color/dracula_fg"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSaveSnippet"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Save"
            android:backgroundTint="@color/dracula_purple"
            android:textColor="@color/dracula_bg"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
