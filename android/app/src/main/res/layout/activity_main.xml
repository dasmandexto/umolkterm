<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dracula_bg">

    <!-- MAIN TERMINAL CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header & Tabs Bar -->
        <LinearLayout
            android:id="@+id/appHeader"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/dracula_bg_darker"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Toggle Left Sidebar Button -->
            <ImageButton
                android:id="@+id/btnToggleSidebar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="@color/dracula_fg"
                android:contentDescription="Меню серверів" />

            <!-- Brand Icon / Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🦇 Umolk"
                android:textColor="@color/dracula_fg"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Term"
                android:textColor="@color/dracula_purple"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Horizontal Tab Switcher -->
            <HorizontalScrollView
                android:id="@+id/tabsScrollView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp">

                <LinearLayout
                    android:id="@+id/tabsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

            <!-- New Tab Action -->
            <ImageButton
                android:id="@+id/btnNewTab"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_input_add"
                android:tint="@color/dracula_purple"
                android:contentDescription="Нова вкладка" />

            <!-- AI Copilot Toggle -->
            <ImageButton
                android:id="@+id/btnToggleAi"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_info_details"
                android:tint="@color/dracula_pink"
                android:contentDescription="AI Copilot" />

            <!-- Settings Button -->
            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_preferences"
                android:tint="@color/dracula_comment"
                android:contentDescription="Налаштування" />
        </LinearLayout>

        <!-- Terminal Stage (Container for terminal views) -->
        <FrameLayout
            android:id="@+id/terminalStage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/dracula_bg">

            <!-- Terminal scrollable view placeholder (TerminalView / Custom View) -->
            <ScrollView
                android:id="@+id/terminalScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/terminalOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:textColor="@color/dracula_fg"
                    android:textSize="12sp"
                    android:typeface="monospace"
                    android:lineSpacingExtra="2dp"
                    android:text="🦇 UmolkTerm Native Terminal Session\n" />
            </ScrollView>

            <!-- Voice Transcript Popup Overlay (Hidden by default) -->
            <LinearLayout
                android:id="@+id/voicePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="8dp"
                android:orientation="vertical"
                android:background="@color/dracula_bg_darker"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/voiceStateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎙 Слухаю (Whisper)..."
                    android:textColor="@color/dracula_red"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/voiceTranscriptText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/dracula_fg"
                    android:textSize="14sp"
                    android:textStyle="italic" />
            </LinearLayout>
        </FrameLayout>

        <!-- Bottom Keyboard Helper Bar (Termius style key-bar) -->
        <HorizontalScrollView
            android:id="@+id/keyBarScrollView"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@color/dracula_bg_darker"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/keyBarContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <!-- Paste and Execute -->
                <Button
                    android:id="@+id/btnKeyPasteRun"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="38dp"
                    android:text="▶ 📋"
                    android:textSize="11sp"
                    android:textColor="@color/dracula_green"
                    android:background="@color/dracula_green_tint"
                    android:layout_marginEnd="4dp" />

                <!-- Voice Mic (Whisper) -->
                <Button
                    android:id="@+id/btnKeyMic"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="36dp"
                    android:text="🎙"
                    android:textSize="12sp"
                    android:textColor="@color/dracula_cyan"
                    android:background="@color/dracula_cyan_tint"
                    android:layout_marginEnd="4dp" />

                <!-- Snippets Button -->
                <Button
                    android:id="@+id/btnKeySnippets"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="36dp"
                    android:text="&lt;&gt;"
                    android:textSize="12sp"
                    android:textColor="@color/dracula_purple"
                    android:background="@color/dracula_purple_tint"
                    android:layout_marginEnd="4dp" />

                <!-- Standard keys -->
                <Button
                    android:id="@+id/btnKeyEsc"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="38dp"
                    android:text="Esc"
                    android:textSize="11sp"
                    android:textColor="@color/dracula_fg"
                    android:background="@color/dracula_current_line"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnKeyTab"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="38dp"
                    android:text="Tab"
                    android:textSize="11sp"
                    android:textColor="@color/dracula_fg"
                    android:background="@color/dracula_current_line"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnKeyCtrl"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="38dp"
                    android:text="Ctrl"
                    android:textSize="11sp"
                    android:textColor="@color/dracula_fg"
                    android:background="@color/dracula_current_line"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnKeyUp"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="34dp"
                    android:text="↑"
                    android:textSize="12sp"
                    android:textColor="@color/dracula_fg"
                    android:background="@color/dracula_current_line"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnKeyDown"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="34dp"
                    android:text="↓"
                    android:textSize="12sp"
                    android:textColor="@color/dracula_fg"
                    android:background="@color/dracula_current_line"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnKeyLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="34dp"
                    android:text="←"
                    android:textSize="12sp"
                    android:textColor="@color/dracula_fg"
                    android:background="@color/dracula_current_line"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnKeyRight"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="34dp"
                    android:text="→"
                    android:textSize="12sp"
                    android:textColor="@color/dracula_fg"
                    android:background="@color/dracula_current_line"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnKeyPipe"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="30dp"
                    android:text="|"
                    android:textSize="12sp"
                    android:textColor="@color/dracula_fg"
                    android:background="@color/dracula_current_line"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnKeyTilde"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="30dp"
                    android:text="~"
                    android:textSize="12sp"
                    android:textColor="@color/dracula_fg"
                    android:background="@color/dracula_current_line"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnKeySlash"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="30dp"
                    android:text="/"
                    android:textSize="12sp"
                    android:textColor="@color/dracula_fg"
                    android:background="@color/dracula_current_line"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnKeyMinus"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="30dp"
                    android:text="-"
                    android:textSize="12sp"
                    android:textColor="@color/dracula_fg"
                    android:background="@color/dracula_current_line" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- LEFT SIDEBAR: SSH HOSTS MANAGER DRAWER -->
    <LinearLayout
        android:id="@+id/sidebarLeft"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/dracula_bg_darker"
        android:clickable="true"
        android:focusable="true">

        <!-- Sidebar Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🖥 SSH Сервери"
                android:textColor="@color/dracula_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSidebarSnippets"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="&lt;&gt;"
                android:textSize="11sp"
                android:textColor="@color/dracula_purple"
                android:background="@color/dracula_current_line"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnSidebarKeyring"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🔑"
                android:textSize="11sp"
                android:textColor="@color/dracula_yellow"
                android:background="@color/dracula_current_line"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnAddHost"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="+ Додати"
                android:textSize="11sp"
                android:textColor="@color/dracula_bg"
                android:background="@color/dracula_purple" />
        </LinearLayout>

        <!-- Search Bar -->
        <EditText
            android:id="@+id/etSearchHosts"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_margin="8dp"
            android:background="@color/dracula_current_line"
            android:hint="Пошук хостів, IP або груп..."
            android:textColorHint="@color/dracula_comment"
            android:textColor="@color/dracula_fg"
            android:textSize="12sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:inputType="text" />

        <!-- Hosts List (RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHostsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="6dp" />
    </LinearLayout>

    <!-- RIGHT DRAWER: AI COPILOT -->
    <LinearLayout
        android:id="@+id/sidebarRightAi"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@color/dracula_bg_darker"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✨ AI Terminal Copilot"
                android:textColor="@color/dracula_pink"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- AI Messages List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAiMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp" />

        <!-- AI Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@color/dracula_bg">

            <EditText
                android:id="@+id/etAiInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Запитайте ШІ..."
                android:textColorHint="@color/dracula_comment"
                android:textColor="@color/dracula_fg"
                android:textSize="12sp"
                android:maxLines="3" />

            <Button
                android:id="@+id/btnSendAi"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="▶"
                android:textColor="@color/dracula_bg"
                android:background="@color/dracula_pink" />
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
